{
  "metrics": {
    "uid": "${METRICS_UID}",
    "jsonData": {
      "exemplarTraceIdDestinations": [
        {
          "name": "trace_id",
          "datasourceUid": "${TEMPO_UID}",
          "urlDisplayLabel": "Abrir traza"
        }
      ]
    }
  },
  "tempo": {
    "uid": "${TEMPO_UID}",
    "jsonData": {
      "tracesToLogsV2": {
        "datasourceUid": "${LOKI_UID}",
        "spanStartTimeShift": "-1m",
        "spanEndTimeShift": "1m",
        "tags": [
          {
            "key": "service.name",
            "value": "service_name"
          }
        ],
        "customQuery": true,
        "query": "{${__tags}} | trace_id = \"${__trace.traceId}\""
      }
    }
  },
  "loki": {
    "uid": "${LOKI_UID}",
    "jsonData": {
      "derivedFields": [
        {
          "name": "trace_id",
          "matcherType": "label",
          "matcherRegex": "trace_id",
          "datasourceUid": "${TEMPO_UID}",
          "url": "${__value.raw}",
          "urlDisplayLabel": "Abrir traza"
        }
      ]
    }
  }
}
