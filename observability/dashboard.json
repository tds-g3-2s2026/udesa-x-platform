  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Servicio (diagnóstico)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${METRICS_UID}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, job)",
          "refId": "service"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Ruta (diagnóstico)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${METRICS_UID}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{job=~\"$service\"}, http_route)",
          "refId": "route"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "health_job",
        "label": "Chequeos de salud",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${METRICS_UID}"
        },
        "query": {
          "query": "label_values(probe_success, job)",
          "refId": "health"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "hide": 2
      }
    ]
  },
