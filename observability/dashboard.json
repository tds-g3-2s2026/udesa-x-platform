      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (udesa_http_flow) (rate(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\",http_response_status_code=~\"5..\"}[$__rate_interval])) or (0 * sum by (udesa_http_flow) (rate(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__rate_interval])))) / (sum by (udesa_http_flow) (rate(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__rate_interval])) > 0)",
          "datasource": {
            "type": "prometheus",
