{
  "uid": "udesa-x-observability",
  "title": "UdeSA-X · Observabilidad",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "udesa-x"
  ],
  "timezone": "browser",
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 12,
      "title": "Resumen · flujos de la app",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "title": "Solicitudes",
      "type": "stat",
      "description": "Solicitudes a los flujos instrumentados del gateway en el período seleccionado.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${METRICS_UID}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 14,
      "title": "Errores 5xx",
      "type": "stat",
      "description": "Porcentaje de solicitudes de esos flujos que devolvieron un 5xx.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Sin datos",
          "decimals": 2,
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\",http_response_status_code=~\"5..\"}[$__range])) or (0 * sum (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range])))) / (sum (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range])) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${METRICS_UID}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 15,
      "title": "Latencia p95",
      "type": "stat",
      "description": "Tiempo que tardó en completarse el 95 % de las solicitudes de esos flujos.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(http_server_request_duration_seconds_bucket{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range]))) and (sum (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range])) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${METRICS_UID}"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 18,
      "title": "Rendimiento por flujo",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 16,
      "title": "Solicitudes, errores y latencia por flujo",
      "type": "table",
      "description": "Medidos desde el gateway durante el período seleccionado. Cada flujo tiene sus propios objetivos de latencia y errores en Grafana Alerting.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Flujo"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "login": {
                        "text": "Inicio de sesión"
                      },
                      "feed_first": {
                        "text": "Feed · primera página"
                      },
                      "feed_next": {
                        "text": "Feed · páginas siguientes"
                      },
                      "create_post": {
                        "text": "Crear publicación"
                      },
                      "search_posts": {
                        "text": "Buscar publicaciones"
                      },
                      "profile": {
                        "text": "Ver perfil"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Solicitudes"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errores 5xx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Latencia p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Solicitudes",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "udesa_http_flow",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time": true
            },
            "indexByName": {
              "udesa_http_flow": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "udesa_http_flow": "Flujo",
              "Value #A": "Solicitudes",
              "Value #B": "Errores 5xx",
              "Value #C": "Latencia p95"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (udesa_http_flow) (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range])) > 0",
          "datasource": {
            "type": "prometheus",
            "uid": "${METRICS_UID}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "(sum by (udesa_http_flow) (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\",http_response_status_code=~\"5..\"}[$__range])) or (0 * sum by (udesa_http_flow) (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range])))) / (sum by (udesa_http_flow) (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range])) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${METRICS_UID}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le, udesa_http_flow) (increase(http_server_request_duration_seconds_bucket{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range]))) and on (udesa_http_flow) (sum by (udesa_http_flow) (increase(http_server_request_duration_seconds_count{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__range])) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${METRICS_UID}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 7,
      "title": "Latencia p95 por flujo",
      "type": "timeseries",
      "description": "Medida desde el gateway. Primera página del feed y siguientes tienen clasificaciones distintas.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "login"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Inicio de sesión"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "feed_first"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Feed · primera página"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "feed_next"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Feed · páginas siguientes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "create_post"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Crear publicación"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "search_posts"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Buscar publicaciones"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "profile"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ver perfil"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, udesa_http_flow) (rate(http_server_request_duration_seconds_bucket{job=\"api-gateway\",udesa_http_flow!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{udesa_http_flow}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${METRICS_UID}"
          },
          "range": true,
          "exemplar": true
        }
      ]
    },
    {
      "id": 17,
      "title": "Errores 5xx por flujo",
      "type": "timeseries",
      "description": "Porcentaje de respuestas 5xx por flujo. Si un flujo no tuvo solicitudes en un intervalo, se muestra un hueco.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "axisSoftMax": 0.01
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "login"
            },
            "properties": [
              {
                "id": "displayName",
