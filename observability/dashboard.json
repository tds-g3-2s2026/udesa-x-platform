              "options": "feed_first"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Feed · primera página"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "feed_next"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Feed · páginas siguientes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "create_post"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Crear publicación"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "search_posts"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Buscar publicaciones"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "profile"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ver perfil"
              }
