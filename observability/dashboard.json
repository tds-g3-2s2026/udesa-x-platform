          },
          "instant": false,
          "range": true,
          "legendFormat": "{{udesa_http_flow}}"
        }
      ]
    },
    {
      "id": 19,
      "title": "Diagnóstico HTTP por ruta",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "collapsed": true,
      "panels": [
        {
          "id": 22,
          "title": "Rutas por impacto",
          "type": "table",
          "description": "Cada fila agrupa un servicio, un método y una ruta en el período seleccionado. Se ordena por cantidad de respuestas 5xx. «Sin etiqueta» agrupa las solicitudes que el servicio no identificó con una ruta.",
          "gridPos": {
            "h": 12,
            "w": 24,
            "x": 0,
            "y": 25
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${METRICS_UID}"
          },
          "fieldConfig": {
            "defaults": {
              "noValue": "—"
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Servicio"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 148
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "Método"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 96
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "Solicitudes"
                },
                "properties": [
                  {
                    "id": "decimals",
                    "value": 0
                  },
                  {
                    "id": "custom.width",
                    "value": 120
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "Errores 5xx"
                },
                "properties": [
                  {
                    "id": "decimals",
                    "value": 0
                  },
                  {
                    "id": "color",
                    "value": {
                      "mode": "thresholds"
                    }
                  },
                  {
                    "id": "thresholds",
                    "value": {
                      "mode": "absolute",
                      "steps": [
                        {
                          "color": "gray",
                          "value": null
                        },
                        {
                          "color": "orange",
                          "value": 0.5
                        }
                      ]
                    }
                  },
                  {
                    "id": "custom.width",
                    "value": 160
                  },
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "color-text"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "% 5xx"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "percentunit"
                  },
                  {
                    "id": "decimals",
                    "value": 2
                  },
                  {
                    "id": "custom.width",
                    "value": 110
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "Latencia p95"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "s"
                  },
                  {
                    "id": "custom.width",
                    "value": 130
                  }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true,
            "enablePagination": true,
            "sortBy": [
              {
                "displayName": "Errores 5xx",
                "desc": true
              }
            ]
          },
          "transformations": [
            {
              "id": "merge",
              "options": {}
            },
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true
                },
                "indexByName": {
                  "job": 0,
                  "http_request_method": 1,
                  "http_route": 2,
                  "Value #A": 3,
                  "Value #B": 4,
                  "Value #C": 5,
                  "Value #D": 6
                },
                "renameByName": {
                  "job": "Servicio",
                  "http_request_method": "Método",
                  "http_route": "Ruta",
                  "Value #A": "Solicitudes",
                  "Value #B": "Errores 5xx",
                  "Value #C": "% 5xx",
                  "Value #D": "Latencia p95"
                }
              }
            }
          ],
          "targets": [
            {
              "refId": "A",
              "expr": "label_replace((sum by (job, http_request_method, http_route) (increase(http_server_request_duration_seconds_count{job=~\"$service\",http_route=~\"$route\"}[$__range])) > 0), \"http_route\", \"Sin etiqueta\", \"http_route\", \"^$\")",
              "datasource": {
                "type": "prometheus",
                "uid": "${METRICS_UID}"
              },
              "format": "table",
              "instant": true,
              "range": false
            },
            {
              "refId": "B",
              "expr": "label_replace((sum by (job, http_request_method, http_route) (increase(http_server_request_duration_seconds_count{job=~\"$service\",http_route=~\"$route\",http_response_status_code=~\"5..\"}[$__range])) or (0 * sum by (job, http_request_method, http_route) (increase(http_server_request_duration_seconds_count{job=~\"$service\",http_route=~\"$route\"}[$__range])))) and (sum by (job, http_request_method, http_route) (increase(http_server_request_duration_seconds_count{job=~\"$service\",http_route=~\"$route\"}[$__range])) > 0), \"http_route\", \"Sin etiqueta\", \"http_route\", \"^$\")",
              "datasource": {
                "type": "prometheus",
                "uid": "${METRICS_UID}"
              },
              "format": "table",
              "instant": true,
              "range": false
            },
            {
              "refId": "C",
              "expr": "label_replace((sum by (job, http_request_method, http_route) (increase(http_server_request_duration_seconds_count{job=~\"$service\",http_route=~\"$route\",http_response_status_code=~\"5..\"}[$__range])) or (0 * sum by (job, http_request_method, http_route) (increase(http_server_request_duration_seconds_count{job=~\"$service\",http_route=~\"$route\"}[$__range])))) / (sum by (job, http_request_method, http_route) (increase(http_server_request_duration_seconds_count{job=~\"$service\",http_route=~\"$route\"}[$__range])) > 0), \"http_route\", \"Sin etiqueta\", \"http_route\", \"^$\")",
              "datasource": {
                "type": "prometheus",
                "uid": "${METRICS_UID}"
              },
              "format": "table",
              "instant": true,
              "range": false
            },
            {
              "refId": "D",
              "expr": "label_replace(histogram_quantile(0.95, sum by (le, job, http_request_method, http_route) (increase(http_server_request_duration_seconds_bucket{job=~\"$service\",http_route=~\"$route\"}[$__range]))) and (sum by (job, http_request_method, http_route) (increase(http_server_request_duration_seconds_count{job=~\"$service\",http_route=~\"$route\"}[$__range])) > 0), \"http_route\", \"Sin etiqueta\", \"http_route\", \"^$\")",
              "datasource": {
                "type": "prometheus",
                "uid": "${METRICS_UID}"
              },
              "format": "table",
              "instant": true,
              "range": false
            }
          ]
        },
        {
          "id": 2,
          "title": "Respuestas 5xx por ruta",
          "type": "timeseries",
          "description": "Porcentaje de respuestas 5xx en cada intervalo. Un intervalo sin solicitudes queda vacío.",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 37
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${METRICS_UID}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "custom": {
                "axisSoftMax": 0.01
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": false
            },
            "tooltip": {
              "mode": "single"
            }
          },
          "targets": [
